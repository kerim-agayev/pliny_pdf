# PlinyPDF environment variables. Copy to .env.local and fill in real values.
# .env.local (and all .env*) are gitignored; only this template is committed.

# --- Process wiring (two-process dev: Next.js :3000 + Elysia backend :8080) ---
#NEXT_PUBLIC_API_URL=http://localhost:8080   # frontend -> backend base URL (prod: https://api.plinypdf.com)

#NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000       # backend CORS allow-origin (credentials) (prod: https://plinypdf.com)
SERVER_PORT=8080                            # Elysia backend port (optional, default 8080)

# --- Cross-subdomain auth (prod only; leave BLANK in local dev) ---
COOKIE_DOMAIN=                              # prod: .plinypdf.com — scopes the session cookie to the parent domain
TRUSTED_ORIGINS=                           # prod: https://plinypdf.com,https://api.plinypdf.com (comma-separated)

# --- SEO (canonical/sitemap/OG absolute URLs) ---
NEXT_PUBLIC_SITE_URL=https://plinypdf.com  # public site origin; used for canonical, hreflang, sitemap, OG images

# --- Gotenberg (PDF <-> Word conversion via Docker) ---
GOTENBERG_URL=http://localhost:3001
GOTENBERG_CONTAINER=pliny_pdf-gotenberg-1   # container name for PDF->Word docker exec (optional)

# --- OCR PDF (ocrmypdf on the host: apt install ocrmypdf tesseract-ocr-{eng,tur,rus}) ---
OCRMYPDF_BIN=ocrmypdf                       # path to the ocrmypdf binary (optional, default: ocrmypdf on PATH)

# --- Database (Supabase Postgres — use the Session pooler host, IPv4) ---
DATABASE_URL=

# --- Auth (Better Auth + Google OAuth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- File storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# --- Observability ---
SENTRY_DSN=                                 # backend (Elysia) error tracking; frontend uses NEXT_PUBLIC_SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=                     # frontend (Next.js) error tracking; same DSN as the Vercel Sentry project
# Source-map upload (optional; CI/Vercel only — leave blank locally):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com  # prod: EU region (provider defaults to US if unset)
